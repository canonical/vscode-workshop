{
  "name": "workshop",
  "displayName": "Workshop",
  "description": "Use workshops as a development environment in VS Code",
  "publisher": "canonical",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/canonical/vscode-workshop.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "ui"
  ],
  "extensionDependencies": [
    "ms-vscode-remote.remote-ssh"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workshop",
          "title": "Workshop",
          "icon": "media/workshop.svg"
        }
      ]
    },
    "views": {
      "workshop": [
        {
          "id": "workshop.workshops",
          "name": "Workshops",
          "icon": "media/workshop.svg",
          "contextualTitle": "Workshop"
        }
      ]
    },
    "commands": [
      {
        "command": "workshop.poll",
        "title": "Refresh Workshops",
        "category": "Workshop",
        "icon": "$(refresh)"
      },
      {
        "command": "workshop.install",
        "title": "Install Workshop from the Snap Store",
        "category": "Workshop"
      },
      {
        "command": "workshop.reopenInWorkshop",
        "title": "Reopen in Workshop",
        "category": "Workshop",
        "icon": "$(remote)"
      },
      {
        "command": "workshop.reopenLocally",
        "title": "Reopen Locally",
        "category": "Workshop",
        "icon": "$(sign-out)"
      },
      {
        "command": "workshop.refreshAndReopen",
        "title": "Refresh and Reopen",
        "category": "Workshop",
        "icon": "$(sync)"
      },
      {
        "command": "workshop.openDefinition",
        "title": "Open Definition File",
        "category": "Workshop",
        "icon": "$(go-to-file)"
      },
      {
        "command": "workshop.continueRefresh",
        "title": "Continue Refresh",
        "category": "Workshop",
        "icon": "$(redo)"
      },
      {
        "command": "workshop.abortRefresh",
        "title": "Abort Refresh",
        "category": "Workshop",
        "icon": "$(discard)"
      },
      {
        "command": "workshop.turnOff",
        "title": "Turn Off…",
        "category": "Workshop",
        "icon": "$(circle-slash)"
      }
    ],
    "viewsWelcome": [
      {
        "view": "workshop.workshops",
        "when": "workshop.viewState == 'unavailable'",
        "contents": "Workshop doesn't appear to be installed or running.\n\nWorkshop is distributed as a snap. Install it, then reload:\n[Install Workshop](command:workshop.install)\n[Reload](command:workshop.poll)\n\nOr from a terminal:\n`snap install workshop --classic`"
      },
      {
        "view": "workshop.workshops",
        "when": "workshop.viewState == 'incompatible'",
        "contents": "Your installed Workshop is too old for this extension.\n\nUpgrade to the latest version, then reload:\n[Reload](command:workshop.poll)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "workshop.reopenLocally",
          "when": "view == workshop.workshops && remoteName == 'ssh-remote'",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "workshop.reopenInWorkshop",
          "when": "view == workshop.workshops && (viewItem == workshop || viewItem == workshop-ready || viewItem == workshop-waiting)",
          "group": "inline"
        },
        {
          "command": "workshop.openDefinition",
          "when": "view == workshop.workshops && viewItem =~ /^workshop/ && viewItem != workshop-pending",
          "group": "inline"
        },
        {
          "command": "workshop.refreshAndReopen",
          "when": "view == workshop.workshops && (viewItem == workshop-ready || viewItem == workshop-active)",
          "group": "inline"
        },
        {
          "command": "workshop.continueRefresh",
          "when": "view == workshop.workshops && (viewItem == workshop-active-waiting || viewItem == workshop-waiting)",
          "group": "inline"
        },
        {
          "command": "workshop.abortRefresh",
          "when": "view == workshop.workshops && (viewItem == workshop-active-waiting || viewItem == workshop-waiting)",
          "group": "inline"
        },
        {
          "command": "workshop.turnOff",
          "when": "view == workshop.workshops && (viewItem == workshop-ready || viewItem == workshop-active)",
          "group": "actions"
        }
      ],
      "statusBar/remoteIndicator": [
        {
          "command": "workshop.reopenLocally",
          "when": "remoteName == 'ssh-remote'",
          "group": "remote_10_ssh-remote_workshop"
        }
      ]
    },
    "colors": [
      {
        "id": "workshop.waitingForeground",
        "description": "Color for workshops in Waiting status — matches the waiting icon stroke.",
        "defaults": {
          "dark": "#E95420",
          "light": "#E95420",
          "highContrast": "#E95420",
          "highContrastLight": "#E95420"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "DISPLAY=${DISPLAY:-:0} XAUTHORITY=${XAUTHORITY:-/tmp/.Xauthority} vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "ws": "^8.21.0"
  }
}
